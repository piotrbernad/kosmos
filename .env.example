# Local development defaults. See DEPLOY.md for production/preview setup on Vercel.

# Postgres connection string. In production this is auto-provisioned by the
# Vercel Marketplace Postgres integration (Neon by default).
DATABASE_URL=postgres://Beniu@localhost:5432/kosmos_issue_tracker

# Better Auth session-signing secret. Generate with `openssl rand -base64 32`
# and set as a Vercel env var (Encrypted) — never commit the production value.
BETTER_AUTH_SECRET=change-me-to-a-random-string-at-least-32-characters

# Base URL the CLI uses to build activation links printed by `admin:invite`.
# In production this is your canonical URL (e.g. https://issues.example.com);
# on preview deployments Vercel provides `VERCEL_URL` if you prefer to compute
# it at request time instead of pinning APP_URL.
APP_URL=http://localhost:3000

# Vercel Blob token. Provisioned by the Blob integration and injected as an
# env var automatically once the store is created. Leave BLANK locally to use
# the .blob-storage/ filesystem fallback served by /local-blob/[...path].
BLOB_READ_WRITE_TOKEN=

# `npm run admin:seed` bootstraps the first admin. In production these are
# one-shot values — set them, run the seed once, then remove or rotate.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
ADMIN_NAME=Administrator
